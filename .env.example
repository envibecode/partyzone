# ── Serveur ──────────────────────────────────────────────
PORT=3000
# URL publique du site (sans slash final). En local : http://localhost:3000
BASE_URL=http://localhost:3000
# Clé de signature des sessions : mets une longue chaîne aléatoire
SESSION_SECRET=change-moi-avec-une-longue-chaine-aleatoire

# ── Discord OAuth2 ───────────────────────────────────────
# https://discord.com/developers/applications
# Onglet OAuth2 → Redirects → ajoute : <BASE_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── YouTube (optionnel) ──────────────────────────────────
# Sans clé, l'import de playlist se fait depuis le navigateur de l'hôte (ça marche très bien).
# Avec une clé (console.cloud.google.com → YouTube Data API v3), l'import est plus rapide et plus fiable.
YOUTUBE_API_KEY=
