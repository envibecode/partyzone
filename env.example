# ── Serveur ──────────────────────────────────────────────
PORT=3000
# URL publique du site (sans slash final). En local : http://localhost:3000
BASE_URL=http://localhost:3000
# Clé de signature des sessions : mets une longue chaîne aléatoire
SESSION_SECRET=change-moi-avec-une-longue-chaine-aleatoire

# ── Discord OAuth2 (facultatif) ──────────────────────────
# https://discord.com/developers/applications
# Onglet OAuth2 → Redirects → ajoute : <BASE_URL>/auth/discord/callback
# Sans ces deux valeurs, seul le mode invité est proposé.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Progression (facultatif) ─────────────────────────────
# Sans DATABASE_URL, tout est écrit dans data/profiles.json — pratique en
# local, mais sur un hébergeur le disque est souvent effacé à chaque
# déploiement. Une base PostgreSQL gratuite (neon.tech) règle le problème.
# Les tables sont créées automatiquement au premier démarrage.
DATABASE_URL=

# ── Panel d'administration ───────────────────────────────
# Deux façons d'être admin, au choix (ou les deux) :
#  1. ADMIN_KEY : une phrase secrète. Va sur <BASE_URL>/#admin (avec le
#     #admin), tape la clé une fois : le droit est enregistré pour de bon.
#  2. ADMIN_IDS : les identifiants de tes comptes, séparés par des virgules.
#     Tu les trouves dans la liste des joueurs du panel (ex. discord:1234).
ADMIN_KEY=
ADMIN_IDS=
