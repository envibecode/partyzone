{
  "name": "partyzone",
  "version": "1.0.0",
  "description": "Casino entre amis en pièces virtuelles : blackjack, roulette, Plinko, caisses à memes et un clicker pour miner ses pièces. Aucun achat, aucun argent réel.",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node test/harness.js",
    "test:economy": "node test/economy.js",
    "test:party": "node test/party.js",
    "test:poker": "node test/poker-sim.js",
    "test:ui": "node test/ui.js",
    "test:ui-party": "node test/ui-party.js",
    "test:bj": "node test/blackjack.js",
    "test:uno": "node test/uno-sim.js",
    "test:belote": "node test/belote-sim.js",
    "test:monopoly": "node test/monopoly-sim.js",
    "test:persist": "node test/party-persist.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pg": "^8.23.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "socket.io-client": "^4.8.3"
  }
}
