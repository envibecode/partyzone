    "test:paris": "node test/paris-sim.js",
    "test:mois": "node test/mois-sim.js",
    "test:rivalites": "node test/rivalites-live.js",
    "test:ui-rivalites": "node test/ui-rivalites.js",
    "test:echanges": "node test/echanges-sim.js",
    "test:ui-echanges": "node test/ui-echanges.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pg": "^8.23.0",
    "socket.io": "^4.8.1"
